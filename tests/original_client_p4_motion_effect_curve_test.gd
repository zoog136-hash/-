extends "res://tests/original_client_test_base.gd"
## C15 - C17 acceptance tests.
const MOTION = preload("res://scripts/original_client/actor_motion.gd")
const EFFECT = preload("res://scripts/original_client/effect_lifecycle.gd")
const CURVE = preload("res://scripts/original_client/curve_path.gd")

func run() -> void:
	var state: Dictionary = MOTION.make_state()
	state = MOTION.receive_position(state, 16400, 77)
	check("C15-T01", state.received_position == Vector2i(2 * 16400 - 0x8000, 77), "received position: x = 2x - 0x8000")
	check("C15-T01", MOTION.internal_x(0) == -32768 and MOTION.internal_x(0x8000) == 32768, "internal x is signed 32-bit")
	var moving: Dictionary = MOTION.begin_step(state, Vector2i(10, 10), 2, 5, 3)
	check("C15-T01", moving.draw_anchor == Vector2i(10, 10) and moving.step_destination == Vector2i(12, 10) and moving.facing == 2 and moving.ordinal == 1, "draw anchor, step destination and the first advance")
	check("C15-T01", moving.received_position == state.received_position, "receiving and stepping are separate coordinates")
	check("C15-T01", MOTION.begin_step(state, Vector2i(0, 0), 0, 1, 0).ordinal == 0, "a one-point path does not advance")
	moving["manager_flags"] = 7
	moving["manager_counter"] = 3
	moving["queue"] = [1, 2, 3]
	var cancelled: Dictionary = MOTION.cancel_ack(moving)
	check("C15-T01", cancelled.manager_flags == 0 and cancelled.manager_counter == 0, "CANCEL ACK resets the manager flags and counter")
	check("C15-T01", cancelled.draw_anchor == moving.draw_anchor and cancelled.step_destination == moving.step_destination and cancelled.queue == [1, 2, 3], "CANCEL ACK keeps coordinates, the current step and the queue")
	var far: Dictionary = MOTION.end_event(moving, false)
	check("C15-T02", far.replan_possible == true and far.path_kept == true, "END far from the target keeps a replannable path")
	check("C15-T02", MOTION.end_event(moving, true).replan_possible == false, "END near the target does not replan")
	var timers: Dictionary = MOTION.schedule_timer(MOTION.make_state(), 5, 100, "global_player")
	timers = MOTION.schedule_timer(timers, 5, 200, "nonplayer_walker")
	check("C15-T03", MOTION.cancel_timer(timers, 5, 100).timers.size() == 1 and MOTION.cancel_timer(timers, 5, 100).timers[0].object == 200, "same callback, different object: the other object's timer survives")
	check("C15-T03", MOTION.cancel_timer(timers, 6, 100).timers.size() == 2 and MOTION.cancel_timer(timers, 5, 300).timers.size() == 2, "a mismatch on either field cancels nothing")

	var missile: Dictionary = EFFECT.make_instance("missile11", "src", "tgt", 1, 0, "arrival", "attack_range_receive")
	missile["remaining"] = 1
	var spent: Dictionary = EFFECT.missile_step(missile, false)
	check("C16-T01", spent.effect.state == "removed" and spent.completion_callback == false, "missile with no repetitions left removes without a callback")
	var arrived: Dictionary = EFFECT.missile_step(missile, true)
	check("C16-T01", arrived.completion_callback == true and arrived.effect.state == "removed", "missile arrival fires the completion callback")
	var direct: Dictionary = EFFECT.make_instance("direct21", "src", "tgt", 2, 0, "display", "caster_command")
	var advanced: Dictionary = EFFECT.direct_advance(direct, true)
	check("C16-T02", advanced.effect.state == "completed_display" and advanced.removed_now == false, "direct effect is not deleted on advance")
	check("C16-T02", EFFECT.direct_callback(advanced.effect).removed == true, "it is removed on the next callback")
	check("C16-T02", EFFECT.direct_callback(direct).removed == false, "a callback before completion removes nothing")
	var splash: Dictionary = EFFECT.make_instance("splash64", "src", "tgt", 3, 0, "activation", "sequential_target")
	check("C16-T02", EFFECT.splash_activate(splash).activation_callback == true and EFFECT.splash_advance(splash, false).effect.state == "removed", "splash calls back on activation and is removed on a failed advance")
	var blast: Dictionary = EFFECT.make_instance("blast31", "src", "tgt", 4, 2, "chain", "renderer_key4")
	check("C16-T02", EFFECT.chain_next(blast).spawn != null and EFFECT.chain_next(blast).spawn.kind == "blast31" and EFFECT.chain_next(EFFECT.make_instance("blast31", "s", "t", 4, 1, "chain", "renderer_key4")).spawn == null, "blast/directional chain at ordinal 2 only")
	var none: Dictionary = EFFECT.create_primary(0)
	check("C16-T03", none.primary == null and none.side_visuals_evaluated_separately == true, "no primary effect does not mean no side visual")
	check("C16-T03", EFFECT.create_primary(64).primary == 64 and EFFECT.create_primary(5).primary == null, "factory types are 1/11/21/31/64/78 only")
	check("C16-T03", EFFECT.received_combat_visual(2, 5).fail_sprite == null and EFFECT.received_combat_visual(2, 5, 900).fail_sprite == 900, "no automatic failure sprite")
	var moved: Dictionary = EFFECT.callback_target_position("tgt", {"tgt": Vector2i(50, 60)}, Vector2i(1, 1))
	check("C16-T04", moved.position == Vector2i(50, 60) and moved.requeried == true, "the target position is re-read at callback time")
	check("C16-T04", EFFECT.callback_target_position("gone", {}, Vector2i(1, 1)).requeried == false, "an unknown target falls back and says so")
	check("C16-T04", EFFECT.QUEUE_KINDS.size() == 4, "four queue kinds stay separate")

	check("C17-T01", CURVE.lroundf(0.5) == 1 and CURVE.lroundf(-0.5) == -1 and CURVE.lroundf(2.5) == 3 and CURVE.lroundf(-2.5) == -3, "half away from zero")
	check("C17-T01", CURVE.lroundf(0.49999997) == 0 and CURVE.lroundf(-0.4) == 0 and CURVE.lroundf(1.5) == 2, "values just under a half do not round up")
	check("C17-T01", CURVE.half_x(3) == 1.5 and CURVE.linf(Vector2(0, 0), Vector2(3, -7)) == 7.0, "x halved in float32, L-infinity distance")
	check("C17-T01", is_equal_approx(CURVE.knot_delta(Vector2(0, 0), Vector2(16, 3)), 4.0), "(16^2)^0.25 = 4")
	var mid: Vector2 = CURVE.nested_cubic(Vector2(0, 0), Vector2(1, 0), Vector2(2, 0), Vector2(3, 0), 0.0, 1.0, 2.0, 3.0, 1.5)
	check("C17-T01", is_equal_approx(mid.x, 1.5) and is_equal_approx(mid.y, 0.0), "a straight line stays straight under the nested cubic")
	var cache := CURVE.PathCache.new()
	cache.store(10, 10, 50, 40, "path_in_land_A")
	check("C17-T02", cache.lookup(10, 10, 50, 40) == "path_in_land_A", "the same four coordinates hit regardless of land or terrain")
	check("C17-T02", cache.design_invalidate_all().design_addition != "" and cache.lookup(10, 10, 50, 40) == null, "safe invalidation is recorded as a design addition")
	var full := CURVE.PathCache.new()
	for i: int in 500:
		full.store(i, 0, 0, 0, i)
	check("C17-T02", full.store(9999, 0, 0, 0, 1).stored == false and full.store(3, 0, 0, 0, 7).stored == true, "capacity 500; replacing a key still works, a new key is refused (policy unverified)")
	finish("ORIGINAL_CLIENT_P4_RESULT")
