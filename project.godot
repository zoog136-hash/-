; Engine configuration file.
; Twilight Knight Offline RPG V20 Lineage-style HUD
config_version=5

[application]
config/name="황혼의 기사 · Offline RPG V20 LINEAGE HUD"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=60

[debug]
gdscript/warnings/treat_warnings_as_errors=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/use_nearest_mipmap_filter.mobile=false

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=true

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
toggle_auto={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":84)]}
open_inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}
open_menu={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77)]}
open_map={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":9)]}
quick_potion={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
save_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194332)]}
load_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194336)]}
toggle_collision_debug={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194330)]}

[physics]
common/physics_ticks_per_second=60
