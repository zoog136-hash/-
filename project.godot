; Engine configuration file.
; Twilight Offline RPG V16
; Godot 4.x / Android mobile / 16:9 landscape
;
; This file is generated for the V16 mobile project.
; Edit from Project > Project Settings when possible.

config_version=5

[application]

config/name="황혼의 기사 · Offline RPG V16"
run/main_scene="res://main.tscn"
run/max_fps=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/use_nearest_mipmap_filter.mobile=false

[input_devices]

buffering/agile_event_flushing=true
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true

