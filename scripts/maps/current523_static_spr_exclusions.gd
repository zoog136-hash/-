static func reason(row: Dictionary) -> String:
	if int(row.get("sprite_id",-1)) not in IDS:return ""
	if not row.get("source_member") is String or not row.get("source_sha256") is String:return ""
	if not row.get("source_byte_offset") is int or not row.get("raw_bytes") is PackedByteArray:return ""
	var original: PackedByteArray=row.raw_bytes
	if original.size()!=6 and original.size()!=10:return ""
	var identity: String="%s\n%s\n%d\n%s"%[row.source_member,row.source_sha256,int(row.source_byte_offset),original.hex_encode()]
	return REASON if RECORD_KEYS.has(PACK.digest(identity.to_utf8_buffer())) else ""

static func sprite_reason(sprite_id: int) -> String:
	if DUMMY_DECLARATIONS.has(sprite_id):return DUMMY_REASON
	return WITHDRAWN_REASON if sprite_id in WITHDRAWN_IDS else ""

static func reasons(row: Dictionary, declaration: Dictionary={}) -> Array[String]:
	var result: Array[String]=[]
	var exact: String=reason(row)
	if not exact.is_empty():result.append(exact)
	var sprite: String=sprite_reason(int(row.get("sprite_id",-1)))
	if not sprite.is_empty():result.append(sprite)
	if bool(declaration.get("explicit_dummy",false)) and DUMMY_REASON not in result:result.append(DUMMY_REASON)
	return result
