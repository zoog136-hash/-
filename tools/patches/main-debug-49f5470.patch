diff --git a/tests/main_debug_crafting_blessing_test.gd b/tests/main_debug_crafting_blessing_test.gd
new file mode 100644
--- /dev/null
+++ b/tests/main_debug_crafting_blessing_test.gd
@@ -0,0 +1,60 @@
+extends SceneTree
+
+const CRAFT = preload("res://scripts/crafting/expanded_crafting.gd")
+var failures: Array[String] = []
+
+func check(condition: bool, description: String) -> void:
+	if not condition:
+		failures.append(description)
+
+func plain_item() -> Dictionary:
+	return {"name": "test_material", "level": 0, "element": "", "element_level": 0}
+
+func _initialize() -> void:
+	check(CRAFT._pristine(plain_item()), "plain +0 equipment remains a valid material")
+	for blessing: Dictionary in [{"bless_state": "blessed"}, {"bless_state": "축복"}, {"blessed": true}, {"bless_state": "BLESSED"}]:
+		var item: Dictionary = plain_item()
+		item.merge(blessing, true)
+		check(not CRAFT._pristine(item), "blessing must protect physical item: " + str(blessing))
+	for changed: Dictionary in [{"level": 1}, {"element": "fire"}, {"element_level": 1}, {"record": {"custom": true}}, {"record": "invalid"}]:
+		var item: Dictionary = plain_item()
+		item.merge(changed, true)
+		check(not CRAFT._pristine(item), "modified or malformed equipment stays protected: " + str(changed))
+	# Explicit synthetic transaction fixture, not an assertion about source-game
+	# costs or drop rates. Calls the production quote/execute implementation.
+	var crafting = CRAFT.new()
+	crafting.recipes = {
+		"test_recipe": {
+			"result": {"item": "test_output", "quantity": 1},
+			"materials": [{"item": "test_material", "quantity": 1}],
+			"adena": 5
+		}
+	}
+	var records: Dictionary = {
+		"test_material": {"slot": "weapon", "grade": "일반", "weight": 1},
+		"test_output": {"slot": "weapon", "grade": "일반", "weight": 1}
+	}
+	var blessed: Dictionary = plain_item()
+	blessed.merge({"bless_state": "blessed", "blessed": true}, true)
+	var physical: Dictionary = {"1": blessed.duplicate(true)}
+	var inventory: Dictionary = {"test_material": 1}
+	var before_physical: Dictionary = physical.duplicate(true)
+	var before_inventory: Dictionary = inventory.duplicate(true)
+	var rejected: Dictionary = crafting.execute("test_recipe", 1, inventory, 100, records, physical, {}, 1, 100, 2)
+	check(not bool(rejected.get("ok", false)), "only-blessed recipe must fail")
+	check(physical == before_physical, "failed craft preserves blessed instance exactly")
+	check(inventory == before_inventory, "failed craft preserves inventory exactly")
+	physical = {"1": blessed.duplicate(true), "2": plain_item()}
+	inventory = {"test_material": 2}
+	var accepted: Dictionary = crafting.execute("test_recipe", 1, inventory, 100, records, physical, {}, 2, 100, 3)
+	check(bool(accepted.get("ok", false)), "mixed material inventory can craft with plain item")
+	check(physical.has("1") and physical.get("1", {}) == blessed, "lower sorted blessed ID must survive")
+	check(not physical.has("2"), "plain ID must be the consumed material")
+	check(physical.has("3") and str(physical.get("3", {}).get("name", "")) == "test_output", "output receives distinct physical ID")
+	check(int(accepted.get("gold_after", -1)) == 95, "normal craft cost is unchanged")
+	if failures.is_empty():
+		print("MAIN_DEBUG_CRAFTING_BLESSING_OK")
+	else:
+		for failure: String in failures:
+			print("FAIL: ", failure)
+	quit(0 if failures.is_empty() else 1)
diff --git a/tests/main_debug_failed_load_test.gd b/tests/main_debug_failed_load_test.gd
new file mode 100644
--- /dev/null
+++ b/tests/main_debug_failed_load_test.gd
@@ -0,0 +1,53 @@
+extends SceneTree
+
+const WORLD = preload("res://scripts/world.gd")
+var failures: Array[String] = []
+
+func check(condition: bool, description: String) -> void:
+	if not condition:
+		failures.append(description)
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func run() -> void:
+	# Only the existing test_project.py runner's isolated Linux/Windows home is
+	# accepted. Never rename, overwrite or delete an existing player's save.
+	var platform: String = OS.get_name()
+	var isolated_home: String = OS.get_environment("APPDATA") if platform == "Windows" else OS.get_environment("XDG_DATA_HOME")
+	if platform not in ["Linux", "Windows"] or not isolated_home.get_file().begins_with("twilight-test-"):
+		print("MAIN_DEBUG_FAILED_LOAD_SKIP: use tools/test_project.py with isolated test homes")
+		quit(0)
+		return
+	if FileAccess.file_exists(WORLD.SAVE_PATH):
+		print("MAIN_DEBUG_FAILED_LOAD_SKIP: existing save is protected")
+		quit(0)
+		return
+	# Do not add the world to the tree: this exercises the real early-load code
+	# without starting a game, autosaving, spawning monsters or touching UI.
+	var world = WORLD.new()
+	var expected_attack: Dictionary = {"probe": true, "id": 911}
+	world.pending_attack = expected_attack.duplicate(true)
+	var generation_before: int = world.combat_generation
+	world._load_game(true)
+	check(world.combat_generation == generation_before, "missing save preserves combat generation")
+	check(world.pending_attack == expected_attack, "missing save preserves pending attack")
+	world.pending_attack = expected_attack.duplicate(true)
+	generation_before = world.combat_generation
+	var file := FileAccess.open(WORLD.SAVE_PATH, FileAccess.WRITE)
+	if file == null:
+		check(false, "test could not create its own isolated invalid JSON")
+	else:
+		file.store_string("{invalid_json")
+		file.close()
+		world._load_game(true)
+		check(world.combat_generation == generation_before, "invalid JSON preserves combat generation")
+		check(world.pending_attack == expected_attack, "invalid JSON preserves pending attack")
+		check(DirAccess.remove_absolute(WORLD.SAVE_PATH) == OK, "remove only the test-created save")
+	world.free()
+	if failures.is_empty():
+		print("MAIN_DEBUG_FAILED_LOAD_OK")
+	else:
+		for failure: String in failures:
+			print("FAIL: ", failure)
+	quit(0 if failures.is_empty() else 1)
diff --git a/tests/main_debug_input_bindings_test.gd b/tests/main_debug_input_bindings_test.gd
new file mode 100644
--- /dev/null
+++ b/tests/main_debug_input_bindings_test.gd
@@ -0,0 +1,35 @@
+extends SceneTree
+
+var failures: Array[String] = []
+
+func check(condition: bool, description: String) -> void:
+	if not condition:
+		failures.append(description)
+
+func matches(action: String, code: Key) -> bool:
+	var event := InputEventKey.new()
+	event.physical_keycode = code
+	event.pressed = true
+	return InputMap.event_is_action(event, action)
+
+func _initialize() -> void:
+	check(matches("move_left", KEY_LEFT), "Left arrow moves left")
+	check(matches("move_right", KEY_RIGHT), "Right arrow moves right")
+	check(matches("move_up", KEY_UP), "Up arrow remains unchanged")
+	check(matches("move_down", KEY_DOWN), "Down arrow remains unchanged")
+	check(matches("move_left", KEY_A), "A remains bound")
+	check(matches("move_right", KEY_D), "D remains bound")
+	check(matches("move_up", KEY_W), "W remains bound")
+	check(matches("move_down", KEY_S), "S remains bound")
+	check(matches("open_map", KEY_TAB), "Tab opens map")
+	check(matches("save_game", KEY_F5), "F5 saves as documented")
+	check(matches("load_game", KEY_F9), "F9 loads as documented")
+	check(not matches("load_game", KEY_F5), "F5 must never trigger load")
+	check(not matches("move_left", KEY_INSERT), "Insert must not move left")
+	check(not matches("move_right", KEY_PAUSE), "Pause must not move right")
+	if failures.is_empty():
+		print("MAIN_DEBUG_INPUT_BINDINGS_OK")
+	else:
+		for failure: String in failures:
+			print("FAIL: ", failure)
+	quit(0 if failures.is_empty() else 1)
