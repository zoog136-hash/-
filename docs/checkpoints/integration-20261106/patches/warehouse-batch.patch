+extends RefCounted
+## Explicit reviewed intents only. No interpretation of original All buttons.
+const STORE=preload("res://scripts/warehouse/local_warehouse.gd")
+const NATIVE=preload("res://scripts/loot/current523_native_stack.gd")
+const AWAKENING=preload("res://scripts/cards/source_awakening_items.gd")
+var quotes: Dictionary={}
+var receipts: Dictionary={}
+var busy: bool=false
+var uncertain: bool=false
+
+func fail(code: String,reason: String) -> Dictionary:
+	return {"ok":false,"code":code,"reason":reason,"saved":false,"live_adopted":false}
+
+func snapshot(world: Node) -> Dictionary:
+	return {"inventory":world.inventory.duplicate(true),"item_instances":world.item_instances.duplicate(true),"warehouse":world.warehouse.snapshot(),"equipped_items":world.equipped_items.duplicate(true),"consumable_state":world.consumable_service.export_state().duplicate(true)}
+
+func prepare(world: Node,direction: String,entries: Array) -> Dictionary:
+	if busy or uncertain or NATIVE.busy or not str(world.patch523_owner_state_problem).is_empty() or world.quest_service.save_blocked:return fail("owner_held","창고 거래 저장 보호 중")
+	if direction not in ["deposit","withdraw"] or entries.is_empty():return fail("invalid_intents","방향과 명시적 선택 목록이 필요합니다")
+	var before: Dictionary=snapshot(world)
+	var inventory: Dictionary=before.inventory.duplicate(true);var physical: Dictionary=before.item_instances.duplicate(true)
+	var warehouse=STORE.new();warehouse.stacks=before.warehouse.stacks.duplicate(true);warehouse.instances=before.warehouse.instances.duplicate(true)
+	var source: Dictionary=before.item_instances if direction=="deposit" else before.warehouse.instances
+	var seen: Dictionary={};var native_moves: Array=[];var reviewed: Array=[];var totals: Dictionary={}
+	var weight: int=world._inventory_total_weight()
+	for raw: Variant in entries:
+		if not raw is Dictionary or not raw.get("record") is Dictionary or not raw.get("item_name") is String or not raw.get("instance_id") is String or not raw.get("source_id") is String or not NATIVE.integer(raw.get("quantity")):return fail("invalid_intent","아이템·정확한 원문 레코드·소유 ID·정수 수량이 필요합니다")
+		var name_value: String=raw.item_name;var uid: String=raw.instance_id;var quantity: int=int(raw.quantity)
+		var record: Dictionary=world._find_catalog_item_record(name_value)
+		if not world.equipment_collections._same_save_value(record,raw.record) or raw.source_id.is_empty() or record.get("sourceId")!=raw.source_id:return fail("source_changed","검토한 원본 카탈로그 정체가 달라졌습니다")
+		var problem: String=world._warehouse_transfer_reason(name_value,quantity,direction,uid)
+		if not problem.is_empty():return fail("ineligible",problem)
+		var key: String="physical:"+uid if not uid.is_empty() else "source:"+raw.source_id
+		if seen.has(key):return fail("duplicate_selection","동일 소유 개체/묶음은 한 번만 명시하세요")
+		seen[key]=true
+		totals[name_value]=int(totals.get(name_value,0))+quantity
+		if direction=="withdraw" and name_value==world.titles.source.powder_record.get("name","") and not world.titles.can_pickup({"item_name":name_value,"quantity":totals[name_value]}):return fail("holding_limit","누적 소지 수량 한도 초과")
+		var native_claim: bool=false
+		for item: Variant in source.values():
+			if item is Dictionary and item.get("name")==name_value and item.has(NATIVE.RECEIPT):native_claim=true;break
+		var is_equipment: bool=not world._enhancement_kind_for_record(record).is_empty()
+		var awakening: bool=AWAKENING.has_physical_item(name_value,source)
+		if native_claim:
+			var owned: Dictionary=NATIVE.proof_entry(source.get(uid),uid)
+			if owned.is_empty() or owned.record!=record or owned.record.get("sourceId")!=raw.source_id:return fail("native_identity","실제 원본 묶음과 검토 정체가 다릅니다")
+			if quantity!=int(owned.remaining):return fail("native_partition_pending","원본 묶음 일부 분할의 다중 거래 계약은 보류입니다. 전체 배치는 저장하지 않습니다")
+			if world._item_locked(name_value) or world._item_locked(name_value,uid):return fail("locked","잠긴 원본 개체는 이동할 수 없습니다")
+			if direction=="deposit" and (owned.receipt.source_original_item.get("IsStorable")!=true or world._is_instance_equipped(uid)):return fail("native_storage","원본 보관·장착 조건 미충족")
+			var from_counts: Dictionary=inventory if direction=="deposit" else warehouse.stacks
+			var to_counts: Dictionary=warehouse.stacks if direction=="deposit" else inventory
+			var from_instances: Dictionary=physical if direction=="deposit" else warehouse.instances
+			var to_instances: Dictionary=warehouse.instances if direction=="deposit" else physical
+			if not NATIVE.integer(from_counts.get(name_value,0)) or int(from_counts.get(name_value,0))<quantity or not NATIVE.integer(to_counts.get(name_value,0)) or int(to_counts.get(name_value,0))>9007199254740991-quantity or to_instances.has(uid):return fail("native_collision","원본 수량·개체 충돌")
+			if direction=="deposit" and int(to_counts.get(name_value,0))>1000000-quantity:return fail("warehouse_limit","기존 창고 저장 한도 초과")
+			to_instances[uid]=from_instances[uid].duplicate(true);from_instances.erase(uid)
+			from_counts[name_value]=int(from_counts[name_value])-quantity
+			if int(from_counts[name_value])==0:from_counts.erase(name_value)
+			to_counts[name_value]=int(to_counts.get(name_value,0))+quantity
+			native_moves.append({"physical_id":uid,"item_name":name_value,"quantity":quantity,"direction":direction})
+		else:
+			if direction=="deposit" and not AWAKENING.storage_allowed(name_value,record,before.item_instances):return fail("storage","원본 보관 제한")
+			if is_equipment or awakening:
