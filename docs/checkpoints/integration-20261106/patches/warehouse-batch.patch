+		if not move is Dictionary or move.get("direction") not in ["deposit","withdraw"] or not move.get("physical_id") is String or not integer(move.get("quantity")):return {"ok":false,"save_attempted":false,"error":ERR_INVALID_DATA}
+		var uid: String=move.physical_id
+		if selected.has(uid):return {"ok":false,"save_attempted":false,"error":ERR_INVALID_DATA}
+		var from_instances: Dictionary=world.item_instances if move.direction=="deposit" else world.warehouse.instances
+		var to_instances: Dictionary=payload.warehouse.instances if move.direction=="deposit" else payload.item_instances
+		var remaining_instances: Dictionary=payload.item_instances if move.direction=="deposit" else payload.warehouse.instances
+		var old_destination: Dictionary=world.warehouse.instances if move.direction=="deposit" else world.item_instances
+		var owned: Dictionary=proof_entry(from_instances.get(uid),uid)
+		if owned.is_empty() or owned.record.get("name")!=move.get("item_name") or move.quantity<1 or move.quantity>99 or move.quantity!=owned.remaining or old_destination.has(uid) or remaining_instances.has(uid) or to_instances.get(uid)!=from_instances.get(uid):return {"ok":false,"save_attempted":false,"error":ERR_INVALID_DATA}
+		if world._item_locked(str(move.item_name),uid) or world._item_locked(str(move.item_name)):return {"ok":false,"save_attempted":false,"error":ERR_INVALID_DATA}
+		if move.direction=="deposit" and (owned.receipt.source_original_item.get("IsStorable")!=true or world._is_instance_equipped(uid)):return {"ok":false,"save_attempted":false,"error":ERR_INVALID_DATA}
+		selected[uid]=true
+	# Every other native physical remains byte-value equivalent in its owner.
