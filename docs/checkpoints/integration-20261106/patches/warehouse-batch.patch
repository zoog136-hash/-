+
+func quote(world: Node,direction: String,entries: Array) -> Dictionary:
+	var plan: Dictionary=prepare(world,direction,entries)
+	if not plan.get("ok",false):return plan
+	var id: String=Crypto.new().generate_random_bytes(16).hex_encode()
+	while quotes.has(id):id=Crypto.new().generate_random_bytes(16).hex_encode()
+	plan["world_id"]=world.get_instance_id();quotes[id]=plan.duplicate(true)
+	return {"ok":true,"quote_id":id,"direction":direction,"entries":plan.entries.duplicate(true),"atomic":true,"save_count":1,"transfer_limit_per_entry":99,"cost_policy":"existing_single_transfer_no_added_fee","confirmation_required":true,"native_partial_partition_supported":false}
+
+func confirm(world: Node,quote_id: String,request_id: String) -> Dictionary:
+	if request_id.strip_edges().is_empty():return fail("request_id_required","확정 요청 ID 필요")
+	if receipts.has(request_id):
+		var receipt: Dictionary=receipts[request_id]
+		if receipt.quote_id!=quote_id or receipt.world_id!=world.get_instance_id():return fail("request_collision","확정 요청 ID 충돌")
+		var repeated: Dictionary=receipt.result.duplicate(true);repeated["replayed_receipt"]=true
+		return repeated
+	if busy or uncertain:return fail("owner_held","이전 저장 결과 확인 전 재실행 금지")
+	var plan: Dictionary=quotes.get(quote_id,{})
+	if plan.is_empty() or plan.world_id!=world.get_instance_id():return fail("quote_missing","실제 검토 목록을 다시 준비하세요")
+	if world.equipment_collections._same_save_value(snapshot(world),plan.before)!=true:return fail("stale_quote","검토 후 소유/장착/창고/소비 상태가 변경됐습니다")
+	var current: Dictionary=prepare(world,plan.direction,plan.entries)
+	if not current.get("ok",false):return current
+	if world.equipment_collections._same_save_value(current.payload,plan.payload)!=true:return fail("candidate_changed","확정 후보가 검토 목록과 달라졌습니다")
+	busy=true
+	var pending: Dictionary={"ok":false,"code":"save_outcome_uncertain","saved":null,"save_confirmed":false,"live_adopted":false,"retry_allowed":false,"quote_id":quote_id,"request_id":request_id}
+	receipts[request_id]={"world_id":world.get_instance_id(),"quote_id":quote_id,"result":pending}
+	var saved: Dictionary=NATIVE.save_full_warehouse_batch(world,plan.payload,plan.native_moves)
+	if not saved.get("ok",false):
+		uncertain=saved.get("save_attempted",false);busy=false
+		pending["save_attempted"]=uncertain
+		if not uncertain:pending["saved"]=false
+		pending["code"]="save_outcome_uncertain" if uncertain else "save_guard_rejected"
+		pending["save_error"]=saved.get("error",ERR_INVALID_DATA)
+		receipts[request_id]["result"]=pending.duplicate(true)
+		return pending.duplicate(true)
+	world.inventory=plan.payload.inventory;world.item_instances=plan.payload.item_instances
+	world.warehouse.stacks=plan.payload.warehouse.stacks;world.warehouse.instances=plan.payload.warehouse.instances
+	world.deferred_save.cancel()
+	world._update_hud()
+	if world.hud.has_method("refresh_service"):world.hud.call("refresh_service")
+	var result: Dictionary={"ok":true,"saved":true,"save_confirmed":true,"save_attempted":true,"live_adopted":true,"quote_id":quote_id,"request_id":request_id,"direction":plan.direction,"entries":plan.entries.duplicate(true),"save_count":1}
+	receipts[request_id]["result"]=result.duplicate(true);quotes.erase(quote_id);busy=false
+	return result
