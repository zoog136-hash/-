+static func save_full_warehouse_batch(world: Node,payload: Dictionary,moves: Array) -> Dictionary:
+	if busy or not str(world.patch523_owner_state_problem).is_empty() or world.quest_service.save_blocked:return {"ok":false,"save_attempted":false,"error":ERR_BUSY}
+	if payload.size()!=3 or not payload.get("inventory") is Dictionary or not payload.get("item_instances") is Dictionary or not payload.get("warehouse") is Dictionary or not payload.warehouse.get("instances") is Dictionary or not payload.warehouse.get("stacks") is Dictionary:return {"ok":false,"save_attempted":false,"error":ERR_INVALID_DATA}
+	var selected: Dictionary={}
