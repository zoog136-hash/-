 static func pending(reason: String) -> Dictionary:
 	return {"schema":1,"status":"pending","reason":reason,"native_collection_binding":"pending"}
+
+# Classify from the owner's catalog/raw physical DTO, never display labels or
+# an extra caller-supplied native flag. Incomplete native claims fail closed.
+static func native_claim(record: Dictionary) -> bool:
+	var archive: Variant=record.get("source_definition_archive",{})
+	return record.get("source")=="lineagem_patch523" or record.get("source_snapshot")=="patch523" or record.get("source_projection")=="current523_original_typed_game_dto_v1" or record.get("source_m_native_item")==true or str(record.get("sourceId","")).begins_with("m523:item:") or (archive is Dictionary and archive.get("kind")=="twilight.current523.original-definitions.v1")
+
+# NEW registration only. Saved absent/pending witnesses remain readable below.
+static func new_registration_reason(item: Dictionary,catalog_record: Dictionary,registered_source_id: String) -> String:
+	var physical: Variant=item.get("physical_snapshot",{})
+	var pinned: Dictionary=physical.get("record",{}) if physical is Dictionary and physical.get("record") is Dictionary else {}
+	var native: bool=native_claim(catalog_record) or native_claim(pinned) or registered_source_id.begins_with("m523:item:")
+	if not native:return ""
+	var witness: Variant=item.get("source_provenance")
+	if not witness is Dictionary or witness.get("status")!="verified_item_witness":return "신규 원본 컬렉션 등록 증거 보류 · 실물 보존"
+	if not receipt_valid({"instance_id":item.get("instance_id"),"source_id":item.get("source_id"),"enchant":item.get("enchant"),"source_provenance":witness}):return "신규 원본 등록 증거 형식·정체 불일치"
+	var evidence: Dictionary=witness.source_witness_capture
+	if not evidence.get("pending") is Array or not evidence.pending.is_empty() or evidence.get("ok")!=true or evidence.get("ready_for_owner_recheck")!=true:return "신규 원본 등록 producer 증거 보류"
+	if not physical is Dictionary or physical.is_empty() or not physical.get("record") is Dictionary or physical.get("name")!=item.get("name") or physical.get("level")!=item.get("enchant"):return "신규 원본 등록의 실제 물리 snapshot 필요"
+	if item.get("source_id")!=registered_source_id or pinned.get("sourceId")!=registered_source_id or catalog_record.get("sourceId")!=registered_source_id or INPUT._hash(physical)!=evidence.physical.get("input_snapshot_sha256"):return "신규 원본 등록 실물·등록 원본 키 불일치"
+	for row: Dictionary in [catalog_record,pinned]:
+		if row.get("source_m_native_item")!=true or row.get("source_projection")!="current523_original_typed_game_dto_v1" or row.get("source_definition_archive")!=witness.original_archive or row.get("source_original_item")!=witness.original_item_class or row.get("source_item_class_id")!=witness.item_class_id or row.get("source_bless_raw")!=witness.bless_raw:return "신규 원본 등록 archive·전체 행·축복 불일치"
+	if physical.get("source_bless_code")!=witness.bless_raw:return "신규 원본 등록 명시 물리 축복 필요"
+	var admission: Variant=evidence.get("admission")
+	if not admission is Dictionary or admission.get("catalog_identity_matches")!=true or admission.get("model_original_item_row_matches")!=true:return "신규 원본 등록의 실제 선택 모델 증거 필요"
+	var digest: Variant=admission.get("equipment_model_sha256")
+	if not digest is String or digest.length()!=64 or not digest.is_valid_hex_number(false) or admission.get("equipment_item_key")!=str(int(witness.item_class_id)):return "신규 원본 등록 모델 지문 불일치"
+	return ""
 
 static func capture(world: Node,uid: String) -> Dictionary:
 	var physical: Variant=world.item_instances.get(uid)
