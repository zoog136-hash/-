+func _live_source_actor_buff(actor: Node, entry: Dictionary) -> bool:
+	# Same lifetime/source evidence already required by actor_invisible().
+	# Used only for current-original self buffs; custom/legacy bindings retain
+	# their existing owner behavior and environment admission stays in bindings.
+	var holder: Variant = entry.get("actor")
+	if not holder is WeakRef or holder.get_ref() != actor: return false
+	if entry.get("life") != actor.life_id or entry.get("generation") != service.world.combat_generation: return false
+	var duration: Variant = entry.get("remaining")
+	if typeof(duration) not in [TYPE_INT,TYPE_FLOAT] or not is_finite(float(duration)) or float(duration) <= 0.0: return false
+	var id: Variant = entry.get("id")
+	if typeof(id) not in [TYPE_INT,TYPE_FLOAT] or not is_finite(float(id)) or float(id) <= 0.0 or float(id) != floorf(float(id)): return false
+	var source: Dictionary = service.catalog.row("BuffClass",int(id))
+	return not source.is_empty() and source.get("ID") == id and entry.get("source") == source
