index 0000000000000000000000000000000000000000..f6a80e1f99179601b32a496d89238f9c7f5056c7
--- /dev/null
+++ b/scripts/skills/current523_distance_receiver.gd
@@ -0,0 +1,88 @@
+extends RefCounted
+## Existing world-length distance receiver. Source conversion remains the
+## data owner's explicitly labelled numeric estimate, never a native grid rule.
+const SOURCE=preload("res://scripts/resources/current523_definition_rows.gd")
+const PLAYER=preload("res://scripts/skills/player_skills523.gd")
+const DROPS=preload("res://scripts/loot/patch523_monster_drops.gd")
+const AMMO=preload("res://scripts/loot/patch523_ammo.gd")
+
+static func _number(value: Variant) -> bool:
+	return typeof(value) in [TYPE_INT,TYPE_FLOAT] and is_finite(float(value))
+
+static func _fail(reason: String) -> Dictionary:
+	return {"handled":true,"ok":false,"reason":reason}
+
+# Read-only actual equipment context. No Sprite enum, name-based identity,
+# source admission, weapon-relative spell rule or additional permission is made.
+static func weapon_context(world: Node) -> Dictionary:
+	var worn: Variant=world.equipped_items.get("weapon",{})
+	if not worn is Dictionary:return {"ok":false,"reason":"actual_weapon_slot_unavailable"}
+	var uid: Variant=worn.get("instance_id")
+	if not uid is String or uid.is_empty() or not world.item_instances.get(uid) is Dictionary:return {"ok":false,"reason":"selected_physical_weapon_unavailable"}
+	var physical: Dictionary=world.item_instances[uid]
+	var record: Dictionary=world._equipped_weapon_record()
+	var identity: Dictionary=SOURCE.identity()
+	var item_id: Variant=record.get("source_item_class_id")
+	if identity.is_empty() or not PLAYER._source_integer(item_id) or int(item_id)<1 or record.get("source_projection")!="current523_original_typed_game_dto_v1" or record.get("source_m_native_item")!=true or record.get("source_definition_archive")!=identity:return {"ok":false,"reason":"actual_current_source_weapon_unavailable"}
+	if physical.get("name")!=worn.get("name") or physical.get("name")!=record.get("name") or not physical.get("record") is Dictionary or physical.record.get("sourceId")!=record.get("sourceId") or not world._is_instance_equipped(uid):return {"ok":false,"reason":"weapon_slot_physical_identity_mismatch"}
+	var original: Dictionary=SOURCE.row("ItemClass",int(item_id))
+	if DROPS.current_original_definition(record).is_empty() or DROPS.current_owned_record(physical.record).is_empty() or physical.record.get("source_m_native_item")!=true or physical.record.get("source_snapshot")!="patch523" or physical.record.get("source_definition_archive")!=identity or physical.record.get("source_original_item")!=original or physical.record.get("source_item_class_id")!=item_id or physical.record.get("source_bless_raw")!=record.get("source_bless_raw"):return {"ok":false,"reason":"actual_weapon_current_ownership_definition_mismatch"}
+	if original.is_empty() or original!=record.get("source_original_item") or original.get("TestItem")!=false or not SOURCE.declared_exclusion("ItemClass",original).is_empty() or not record.get("source_condition_pending",[]).is_empty():return {"ok":false,"reason":"source_weapon_original_or_conditions_unavailable"}
+	if not PLAYER._source_integer(physical.get("level")) or int(physical.level)<0 or not DROPS.equipment_error(record,str(world.job_class),int(world.level),int(world.ui_preferences.get("patch523_source_clock_offset_minutes",540))).is_empty():return {"ok":false,"reason":"actual_source_weapon_equipment_conditions_unmet"}
+	var type: Dictionary=AMMO.weapon_type(record)
+	if type.is_empty() or not PLAYER._source_integer(type.get("ID")) or int(type.ID)<1 or SOURCE.row("WeaponType",int(type.ID))!=type or not SOURCE.declared_exclusion("WeaponType",type).is_empty():return {"ok":false,"reason":"original_gameplay_weapon_type_unavailable"}
+	return {"ok":true,"physical_id":uid,"item_class_id":int(item_id),"source_id":record.sourceId,"bless_raw":record.get("source_bless_raw"),"enchant":physical.get("level"),"weapon_type_id":int(type.ID),"weapon_type_row":type.duplicate(true),"original_item_row":original.duplicate(true),"source":identity.duplicate(true),"source_basis":"actual_equipped_physical_ItemClass_ItemBonus_WeaponType","use_authorized":false}
+
+static func _policy(input: Dictionary,scale_field: String="cast_range_to_host_length") -> Dictionary:
+	if scale_field not in ["cast_range_to_host_length","area_radius_to_host_length"]:return _fail("미지원 기존 거리 정책 수신 필드")
+	var file:=FileAccess.open(PLAYER.DISTANCE_INPUT_POLICY_PATH,FileAccess.READ)
+	if file==null or file.get_length()>65536:return _fail("기존 거리 정책 입력을 읽을 수 없습니다")
+	var bytes: PackedByteArray=file.get_buffer(file.get_length());file.close()
+	var parser:=JSON.new()
+	if parser.parse(bytes.get_string_from_utf8())!=OK or not parser.data is Dictionary:return _fail("기존 거리 정책 형식 확인 필요")
+	var policy: Dictionary=parser.data
+	var hash:=HashingContext.new();hash.start(HashingContext.HASH_SHA256);hash.update(bytes)
+	if input.get("policy_path")!=PLAYER.DISTANCE_INPUT_POLICY_PATH or input.get("policy_schema")!="twilight.current523.distance-input-policy.v1" or hash.finish().hex_encode()!=input.get("policy_sha256") or policy.get("schema")!="twilight.current523.distance-input-policy.v1" or policy.get("source_snapshot")!="patch523" or policy.get("source_sha256")!=PLAYER.SOURCE_SHA or policy.get("enabled")!=true or policy.get("origin")!="twilight_adjustable_numeric_estimate" or policy.get("source_raw_distance_unit_scale")!="unconfirmed" or policy.get("native_grid_scale_recovered")!=false or policy.get("host_geometry")!="existing_host_distance_engine_retained":return _fail("원본 거리 입력과 현재 명시적 자체 배율 정책이 다릅니다")
+	var scale: Variant=policy.get(scale_field)
+	if not _number(scale) or float(scale)<=0:return _fail("기존 원본 거리 배율 확인 필요")
+	return {"ok":true,"scale":float(scale)}
+
+# Call before costs and again at the existing impact callback. Only a complete
+# source-reader projection is consumed; absence preserves existing host behavior.
+static func check(world: Node,skill: Dictionary,target: Node,expected: Dictionary={}) -> Dictionary:
+	var source: Variant=skill.get("source523",{})
+	if not source is Dictionary:return {"handled":false,"ok":true}
+	var input: Variant=source.get("distance_numeric_input",{})
