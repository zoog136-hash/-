index 0000000000000000000000000000000000000000..a0ca762a7c231ac7f6c23ebde8c6a2ffa381510f
--- /dev/null
+++ b/scripts/skills/current523_area_receiver.gd
@@ -0,0 +1,51 @@
+extends RefCounted
+## Authenticated source-radius operand for the EXISTING host circle selector.
+## No source unit, new shape, annulus, target order, cap or lifetime is inferred.
+const SOURCE=preload("res://scripts/resources/current523_definition_rows.gd")
+const PLAYER=preload("res://scripts/skills/player_skills523.gd")
+const DISTANCE=preload("res://scripts/skills/current523_distance_receiver.gd")
+
+static func _fail(reason: String) -> Dictionary:
+	return {"handled":true,"ok":false,"reason":reason}
+
+static func check(world: Node,skill: Dictionary,primary: Node=null,expected: Dictionary={}) -> Dictionary:
+	var source: Variant=skill.get("source523",{})
+	if not source is Dictionary:return {"handled":false,"ok":true}
+	var input: Variant=source.get("distance_numeric_input",{})
+	if not input is Dictionary:return _fail("원본 반경 입력 형식 확인 필요")
+	if input.is_empty():return {"handled":false,"ok":true} if expected.is_empty() else _fail("선택 후 원본 반경 입력이 없어졌습니다")
+	var fields: Variant=input.get("fields",{})
+	if not fields is Dictionary:return _fail("원본 반경 필드 증명 확인 필요")
+	if not fields.has("radius"):return {"handled":false,"ok":true} if expected.is_empty() else _fail("선택한 원본 반경 투영이 변경됐습니다")
+	var applied: Variant=source.get("applied",[])
+	if not applied is Array or not applied.has("target_filter") or skill.get("activation")!="active" or skill.get("runtime_blocked",false) or not str(skill.get("source523_block_reason","")).is_empty() or skill.get("mode") not in ["attack","status","turn_undead"]:return _fail("기존 활성·대상 승인 밖의 원본 반경입니다")
+	var identity: Dictionary=SOURCE.identity()
+	var spell_id: Variant=source.get("spell_id")
+	if identity.is_empty() or not PLAYER._source_integer(spell_id) or int(spell_id)<1 or input.get("source")!=identity or input.get("spell_id")!=spell_id or input.get("origin")!="twilight_adjustable_numeric_estimate" or input.get("source_raw_distance_unit_scale")!="unconfirmed" or input.get("native_grid_scale_recovered")!=false or input.get("host_geometry")!="existing_host_distance_engine_retained":return _fail("원본 반경의 현재 주문·출처 정체 불일치")
+	var raw: Dictionary=SOURCE.row("SpellClass",int(spell_id))
+	var bound_sha: Variant=input.get("bound_row_sha256")
+	if not bound_sha is String or bound_sha.length()!=64 or not bound_sha.is_valid_hex_number(false) or raw.is_empty() or PLAYER._source_row_json(raw,bound_sha).is_empty() or not SOURCE.declared_exclusion("SpellClass",raw).is_empty() or raw.get("TestSpell",false):return _fail("원본 반경의 전체 주문 행·고정 지문 불일치")
+	# Preserve the data owner's current supported scope; MinCastRange is NOT
+	# an inner radius and IsAttackRange does not select a weapon here.
+	if raw.get("IsAttackRange") is not bool or raw.IsAttackRange or not DISTANCE._number(raw.get("MinCastRange")) or float(raw.MinCastRange)!=0:return _fail("최소거리·무기 상대 반경은 별도 수신 계약이 필요합니다")
+	var shape: String=str(skill.get("shape",""))
+	var self_center: bool=raw.get("TargettingTypeID")==1 and shape=="self_circle"
+	var target_center: bool=raw.get("TargettingTypeID")==2 and shape in ["circle","target_circle"]
+	if not self_center and not target_center:return _fail("기존 원형 대상 선택과 원문 대상 유형이 다릅니다")
+	if self_center and primary!=null:return _fail("자기 중심 원문 반경에 별도 대상 중심을 넣을 수 없습니다")
+	if target_center and (not is_instance_valid(primary) or primary.get("dead")!=false):return _fail("원문 대상 중심 반경의 실제 선택 대상이 없습니다")
+	if not is_instance_valid(world.player) or world.hp<=0 or not is_instance_valid(world.field_map):return _fail("반경 수신의 실제 플레이어·필드 확인 필요")
+	var policy: Dictionary=DISTANCE._policy(input,"area_radius_to_host_length")
+	if not policy.get("ok",false):return policy
+	var value: Variant=raw.get("TargetAreaRadius")
+	if not DISTANCE._number(value) or float(value)<=0:return _fail("원문 반경의 양수 수치 확인 필요")
+	var radius: float=float(value)*float(policy.scale)
+	var projected: Variant=fields.radius
+	if not is_finite(radius) or radius<=0 or not projected is Dictionary or projected.get("source_field")!="TargetAreaRadius" or projected.get("raw_value")!=value or not DISTANCE._number(projected.get("multiplier")) or float(projected.multiplier)!=float(policy.scale) or not DISTANCE._number(projected.get("host_length_input")) or float(projected.host_length_input)!=radius or not DISTANCE._number(skill.get("radius")) or float(skill.radius)!=radius:return _fail("실제 스킬 반경과 원문 수치·현재 자체 배율 불일치")
+	var limit: Variant=skill.get("targets",6)
+	if not PLAYER._source_integer(limit) or int(limit)<1:return _fail("기존 원형 대상 수 제한 형식 확인 필요")
+	var snapshot: Dictionary={"skill_id":str(skill.get("id","")),"spell_id":int(spell_id),"bound_row_sha256":bound_sha,"policy_sha256":input.policy_sha256,"source":identity.duplicate(true),"radius_world_length":radius,"center_kind":"existing_player_position" if self_center else "existing_selected_target_position","shape":shape,"host_target_limit":int(limit),"player_instance_id":world.player.get_instance_id(),"primary_instance_id":primary.get_instance_id() if target_center else 0,"primary_life_id":primary.get("life_id") if target_center else 0,"field_instance_id":world.field_map.get_instance_id(),"combat_generation":world.combat_generation}
+	if not expected.is_empty() and expected!=snapshot:return _fail("선택 이후 원문 반경·중심 대상 생명·필드가 바뀌었습니다")
+	# Center follows the existing selector at the moment of use; do not freeze
+	# coordinates or replace its target filtering, LOS, sort or target count.
+	return {"handled":true,"ok":true,"snapshot":snapshot,"radius_world_length":radius,"origin":"twilight_adjustable_numeric_estimate","native_area_rule_verified":false}
diff --git a/scripts/skills/current523_distance_receiver.gd b/scripts/skills/current523_distance_receiver.gd
