          "text": "이동할 지역을 선택하라. 월드의 기존 좌표와 충돌 규칙은 그대로 유지된다.",
          "choices": [
            {
              "label": "목적지 선택",
              "action": "teleport"
            }
          ]
        }
      }
    },
    "craft_artisan": {
      "name": "아덴 제작 장인",
      "entry": "welcome",
      "nodes": {
        "welcome": {
          "text": "재료와 아데나가 준비되면 아이템을 제작해 주겠다.",
          "choices": [
            {
              "label": "제작 목록",
              "action": "craft"
            }
          ]
        }
      }
    },
    "buyback_trader": {
      "name": "아덴 아이템 매입상",
      "entry": "welcome",
      "nodes": {
        "welcome": {
          "text": "장착한 장비와 매입 금지 물품은 취급하지 않는다.",
          "choices": [
            {
              "label": "아이템 판매",
              "action": "buyback"
